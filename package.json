{
  "name": "votehope",
  "version": "0.1.0",
  "description": "Self-hosted multiple-choice quizzes and polls for the classroom",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch --env-file-if-exists=.env src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env src/server/index.ts",
    "serve:lan": "node src/server/tools/serve-lan.ts",
    "check": "tsc -p tsconfig.json && svelte-check --tsconfig ./tsconfig.json --threshold warning",
    "test": "vitest run",
    "hash-password": "node src/server/tools/hash-password.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.4",
    "fflate": "^0.8.3",
    "markdown-it": "^15.0.2",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.5.1",
    "@types/qrcode": "^1.5.6",
    "@vscode/markdown-it-katex": "^1.1.2",
    "concurrently": "^10.0.5",
    "dompurify": "^3.4.15",
    "jsdom": "^30.0.1",
    "katex": "^0.18.7",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "^4.8.3",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
