# Copy to .env and adjust. Read by `npm run dev`, `npm start` and `npm run serve:lan`.
#
# On a local network with no domain name, `npm run serve:lan` fills in the address
# and the password by itself; nothing here has to be set by hand.

# Admin password: set ONE of these.
# ADMIN_PASSWORD_HASH is safer (generate with: npm run hash-password).
ADMIN_PASSWORD=change-me
# ADMIN_PASSWORD_HASH=scrypt:16384:8:1:...

# Address students use to reach the server; encoded in join links and QR codes.
# When unset, links use the address the presenter's browser is using, which works
# on a local network if you open the admin page via the computer's network address.
# PUBLIC_URL=https://quiz.example.org

# PORT=3000
# HOST=127.0.0.1           # default 127.0.0.1 in development, 0.0.0.0 in production
# DATA_DIR=./data          # database, uploaded images, generated session secret
# TRUST_PROXY=true         # set when running behind Caddy/nginx
# SESSION_SECRET=...       # optional; generated and stored in DATA_DIR if unset
